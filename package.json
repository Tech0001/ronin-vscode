{
  "name": "ronin-canvas",
  "displayName": "Ronin Canvas",
  "description": "A spatial terminal and agent workspace inside VS Code.",
  "version": "0.5.5",
  "icon": "dist/ronin-icon.png",
  "publisher": "tech0001",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tech0001/ronin-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Tech0001/ronin-vscode/issues"
  },
  "homepage": "https://github.com/Tech0001/ronin-vscode#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onWebviewPanel:ronin.canvas",
    "onUri",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Ronin starts local shell processes."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "ronin.openCanvas",
        "title": "Ronin: Open Canvas"
      },
      {
        "command": "ronin.newTerminal",
        "title": "Ronin: New Terminal"
      },
      {
        "command": "ronin.newAgent",
        "title": "Ronin: New Agent Lane"
      },
      {
        "command": "ronin.interrupt",
        "title": "Ronin: Interrupt Foreground Program"
      },
      {
        "command": "ronin.shiftEnter",
        "title": "Ronin: Send Shift+Enter to Terminal"
      },
      {
        "command": "ronin.escape",
        "title": "Ronin: Send Escape to Terminal"
      },
      {
        "command": "ronin.copy",
        "title": "Ronin: Copy Terminal Selection"
      },
      {
        "command": "ronin.paste",
        "title": "Ronin: Paste into Terminal"
      },
      {
        "command": "ronin.showSidebar",
        "title": "Ronin: Show Sidebar"
      },
      {
        "command": "ronin.stopBackgroundTerminals",
        "title": "Ronin: Stop Background Terminals"
      }
    ],
    "keybindings": [
      {
        "command": "ronin.escape",
        "key": "escape",
        "when": "activeWebviewPanelId == 'ronin.canvas' && webviewFocus && ronin.terminalFocused"
      },
      {
        "command": "ronin.shiftEnter",
        "key": "shift+enter",
        "when": "activeWebviewPanelId == 'ronin.canvas' && webviewFocus && ronin.terminalFocused"
      },
      {
        "command": "ronin.interrupt",
        "key": "ctrl+c",
        "mac": "ctrl+c",
        "when": "activeWebviewPanelId == 'ronin.canvas' && webviewFocus && ronin.terminalFocused"
      },
      {
        "command": "ronin.copy",
        "key": "ctrl+shift+c",
        "mac": "cmd+c",
        "when": "activeWebviewPanelId == 'ronin.canvas' && webviewFocus && ronin.terminalFocused"
      },
      {
        "command": "ronin.paste",
        "key": "ctrl+shift+v",
        "mac": "cmd+v",
        "when": "activeWebviewPanelId == 'ronin.canvas' && webviewFocus && ronin.terminalFocused"
      }
    ],
    "configuration": {
      "title": "Ronin",
      "properties": {
        "ronin.shell": {
          "type": "string",
          "default": "",
          "description": "Shell executable; blank uses your login shell."
        },
        "ronin.fontSize": {
          "type": "number",
          "default": 13,
          "minimum": 9,
          "maximum": 24,
          "description": "Canvas terminal font size."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ronin",
          "title": "Ronin",
          "icon": "dist/ronin.svg"
        }
      ]
    },
    "views": {
      "ronin": [
        {
          "type": "webview",
          "id": "ronin.workspace",
          "name": "Workspace"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "ronin.openCanvas",
          "when": "view == ronin.workspace",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "vitest run src",
    "test:terminals": "npm run build && node tests/terminal-service.mjs",
    "build:linux-pty": "node scripts/build-linux-pty.mjs",
    "vscode:prepublish": "npm run build",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
